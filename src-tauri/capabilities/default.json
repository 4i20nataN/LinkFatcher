{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    "dialog:default",
    "fs:allow-download-write",
    "clipboard-manager:allow-read-text"
  ]
}
